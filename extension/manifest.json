{
  "manifest_version": 3,
  "name": "Agent Token Viewer",
  "version": "2.0.1",
  "description": "ログイン済みのCodex・Claude・Cursorの利用枠を、このブラウザー内のメーターで確認します。",
  "permissions": [
    "alarms",
    "storage",
    "declarativeNetRequestWithHostAccess",
    "tabs"
  ],
  "host_permissions": [
    "https://cursor.com/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Agent Token Viewerを開く"
  },
  "minimum_chrome_version": "120"
}
